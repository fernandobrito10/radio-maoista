# ---------- Discord (obrigatorio) ----------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra os comandos so nesse servidor (aparecem na hora, otimo pra dev).
# Deixe vazio para registrar globalmente (pode levar ~1h pra propagar).
DISCORD_GUILD_ID=

# ---------- Spotify (opcional, so pra links do Spotify) ----------
# https://developer.spotify.com/dashboard -> Create app (Client Credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Mercado usado para resolver album/top tracks
SPOTIFY_MARKET=BR

# ---------- Last.fm (opcional, so pra scrobble) ----------
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# ---------- yt-dlp ----------
# Caminho do binario. Se estiver no PATH, deixe "yt-dlp".
YTDLP_PATH=yt-dlp
# Cookies (ajuda com "Sign in to confirm you're not a bot" e videos restritos).
# Ex.: chrome | firefox | edge | brave  (ou "chrome:Profile 1")
YTDLP_COOKIES_FROM_BROWSER=
# Alternativa: caminho para um arquivo cookies.txt
YTDLP_COOKIES_FILE=
# Teto de banda por faixa (o audio precisa de ~25 KB/s). Sem teto, cada musica
# comeca saturando a conexao. Vazio remove o limite.
YTDLP_LIMIT_RATE=128K
# Clients do YouTube tentados em ordem ate um entregar audio.
# O padrao do yt-dlp (android_vr) anda devolvendo HTTP 403 na midia; "android" funciona.
# Se um dia parar de funcionar, tente: android,default,tv_embedded,mweb
YTDLP_PLAYER_CLIENTS=android,default
# Args extras separados por espaco (avancado)
YTDLP_EXTRA_ARGS=

# ---------- Autocomplete do /play ----------
# Espera (ms) sem digitar antes de sugerir. Cada tecla gera uma interacao;
# o debounce evita uma requisicao por tecla.
AUTOCOMPLETE_DEBOUNCE=300
# Quantas sugestoes mostrar (o que foi digitado sempre vem primeiro)
AUTOCOMPLETE_RESULTS=8
# Timeout (ms) do endpoint de sugestao. Tem que caber nos 3s do token.
AUTOCOMPLETE_TIMEOUT=1500
# 1 = ja manda o yt-dlp buscar em background enquanto a pessoa escolhe, pro
# /play sair instantaneo. 0 desliga (menos CPU, /play volta a esperar ~2,5s).
AUTOCOMPLETE_PREFETCH=1

# ---------- Diagnostico ----------
# 1 = loga heartbeat/resume/close do gateway (pra investigar reconexao)
LOG_GATEWAY=0

# ---------- Comportamento ----------
DEFAULT_VOLUME=70
# Tempo (segundos) que o bot espera em canal vazio / fila vazia antes de sair
IDLE_TIMEOUT=180
MAX_QUEUE_SIZE=1000
